@model MVC.Models.Suppliers.SupplierDetailsModel

@{
    ViewData["Title"] = ViewData["Title"] ?? "تفاصيل المورد";
}

<h1>@ViewData["Title"]</h1>

<div class="card">
    <div class="card-body">
        <h4>@Model.Name</h4>
        <p><strong>الهاتف:</strong> @Model.Phone</p>
        <p><strong>البريد:</strong> @Model.Email</p>
        <p><strong>العنوان:</strong> @Model.Address</p>

        <a class="btn btn-primary" asp-action="Edit" asp-route-id="@Model.Id">تعديل</a>
        <a class="btn btn-danger" asp-action="Delete" asp-route-id="@Model.Id">حذف</a>
        <a class="btn btn-secondary" asp-action="Index">عودة</a>
    </div>
</div>
