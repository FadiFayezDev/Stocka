@model List<MVC.Models.Suppliers.SupplierRowModel>

@{
    ViewData["Title"] = ViewData["Title"] ?? "الموردين";
}

<h1>@ViewData["Title"]</h1>

<p>
    <a class="btn btn-primary" asp-action="Create">إضافة مورد جديد</a>
</p>

<table class="table table-striped">
    <thead>
        <tr>
            <th>الاسم</th>
            <th>الهاتف</th>
            <th>البريد</th>
            <th>العنوان</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var s in Model)
        {
            <tr>
                <td>@s.Name</td>
                <td>@s.Phone</td>
                <td>@s.Email</td>
                <td>@s.Address</td>
                <td>
                    <a class="btn btn-sm btn-secondary" asp-action="Details" asp-route-id="@s.Id">عرض</a>
                    <a class="btn btn-sm btn-primary" asp-action="Edit" asp-route-id="@s.Id">تعديل</a>
                    <a class="btn btn-sm btn-danger" asp-action="Delete" asp-route-id="@s.Id">حذف</a>
                </td>
            </tr>
        }
    </tbody>
</table>
