@using Application.Dtos.Products
@model ProductDto

@{
    ViewData["Title"] = "حذف المنتج";
}

<div class="confirm-page">
    <div class="confirm-card card border-0 shadow-sm">
        <div class="card-body p-lg-5 p-4 text-center">
            <div class="confirm-icon bg-danger-subtle text-danger">
                <i class="bi bi-exclamation-triangle"></i>
            </div>

            <h3 class="fw-bold mb-2">حذف المنتج</h3>
            <p class="text-muted mb-1">هل أنت متأكد من رغبتك في إيقاف هذا المنتج؟</p>
            <p class="text-muted small mb-4">
                سيتم تعطيل المنتج وإزالته من قائمة المنتجات النشطة،
                وسيبقى محفوظاً في السجلات والحركات السابقة.
            </p>

            <div class="confirm-product d-inline-flex align-items-center gap-3 bg-light rounded-3 px-4 py-3 mb-4">
                @if (!string.IsNullOrWhiteSpace(Model.ImageUrl))
                {
                    <img src="@Model.ImageUrl" alt="@Model.Name" class="confirm-thumb" />
                }
                else
                {
                    <span class="confirm-thumb d-flex align-items-center justify-content-center text-muted">
                        <i class="bi bi-box-seam"></i>
                    </span>
                }
                <div class="text-start">
                    <div class="fw-bold">@Model.Name</div>
                    <div class="text-muted small">
                        <span class="font-monospace">@Model.Barcode</span>
                    </div>
                </div>
            </div>

            <div class="d-flex justify-content-center gap-3 flex-wrap">
                <form asp-action="DeleteConfirmed" asp-route-id="@Model.Id" method="post" class="d-inline">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-danger btn-lg px-5">
                        <i class="bi bi-trash me-1"></i> نعم، احذف المنتج
                    </button>
                </form>
                <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-outline-secondary btn-lg px-5">
                    إلغاء
                </a>
            </div>
        </div>
    </div>
</div>

<style>
    .confirm-page {
        max-width: 560px;
        margin: 0 auto;
        padding-top: 24px;
    }

    .confirm-card {
        border-radius: var(--radius-lg);
        overflow: hidden;
    }

    .confirm-icon {
        width: 72px;
        height: 72px;
        margin: 0 auto 20px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 2rem;
    }

    .confirm-thumb {
        width: 56px;
        height: 56px;
        border-radius: 12px;
        object-fit: cover;
        background: var(--surface-muted);
        border: 1px solid var(--border);
        font-size: 1.4rem;
        flex: 0 0 auto;
    }

    .confirm-product .text-start {
        text-align: start !important;
    }

    [dir="rtl"] .confirm-product .text-start {
        text-align: start !important;
    }
</style>