@using Application.Dtos.Products
@model ProductDto

@{
    ViewData["Title"] = "Edit Product";
}

<div class="container-fluid py-4">

    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-3">

        <div>
            <div class="d-flex align-items-center mb-1 gap-2">

                <a asp-action="Index"
                       class="text-decoration-none text-secondary">
                    Products
                </a>

                <span class="text-secondary">/</span>

                <a asp-action="Details"
                       asp-route-id="@Model.Id"
                       class="text-decoration-none text-secondary">
                    Details
                </a>

                <span class="text-secondary">/</span>

                <span class="text-muted">
                    Edit
                </span>

            </div>

            <h2 class="fw-bold mb-0">
                Edit Product
            </h2>

        </div>

        <a asp-action="Details"
               asp-route-id="@Model.Id"
               class="btn btn-outline-secondary">

            <i class="bi bi-arrow-left me-2"></i>
            Back

        </a>

    </div>


    <!-- Edit Form -->
    <form asp-action="Edit"
          method="post"
          enctype="multipart/form-data">

        @Html.AntiForgeryToken()

        <input type="hidden"
               name="Id"
               value="@Model.Id" />


        <div class="card border-0 shadow-sm">

            <div class="card-body p-lg-5 p-4">

                <div class="row g-5">

                    <!-- ========================= -->
                    <!-- Product Information -->
                    <!-- ========================= -->

                    <div class="col-lg-8">

                        <h5 class="fw-bold mb-4">
                            Product Information
                        </h5>


                        <!-- Product Name -->
                        <div class="mb-4">

                            <label for="Name"
                                   class="form-label fw-semibold">
                                Product Name
                            </label>

                            <input type="text"
                                   id="Name"
                                   name="Name"
                                   value="@Model.Name"
                                   class="form-control form-control-lg"
                                   placeholder="Enter product name" />

                        </div>


                        <!-- Price + Barcode -->
                        <div class="row g-4">

                            <!-- Selling Price -->
                            <div class="col-md-6">

                                <label for="SellingPrice"
                                       class="form-label fw-semibold">
                                    Selling Price
                                </label>

                                <div class="input-group">

                                    <input type="number"
                                           id="SellingPrice"
                                           name="SellingPrice"
                                           value="@Model.SellingPrice"
                                           class="form-control"
                                           step="0.01"
                                           min="0"
                                           placeholder="0.00" />

                                    <span class="input-group-text">
                                        ج.م
                                    </span>

                                </div>

                            </div>


                            <!-- Barcode -->
                            <div class="col-md-6">

                                <label for="Barcode"
                                       class="form-label fw-semibold">
                                    Barcode
                                </label>

                                <input type="text"
                                       id="Barcode"
                                       name="Barcode"
                                       value="@Model.Barcode"
                                       class="form-control"
                                       placeholder="Enter barcode" />

                            </div>

                        </div>


                        <!-- Category -->
                        <div class="mt-4">

                            <label for="CategoryId"
                                   class="form-label fw-semibold">
                                Category
                            </label>

                            <input type="text"
                                   id="CategoryId"
                                   name="CategoryId"
                                   value="@Model.CategoryId"
                                   class="form-control"
                                   readonly />

                            <small class="text-muted">
                                Category selection can be replaced with a dropdown
                                when the categories are loaded into the View.
                            </small>

                        </div>


                        <!-- Status -->
                        <div class="mt-4">

                            <div class="status-box">

                                <div>
                                    <div class="fw-semibold">
                                        Product Status
                                    </div>

                                    <small class="text-muted">
                                        Enable or disable this product.
                                    </small>
                                </div>

                                <div class="form-check form-switch">

                                    <input type="checkbox"
                                           id="IsActive"
                                           name="IsActive"
                                           value="true"
                                           class="form-check-input"
                                    @(Model.IsActive ? "checked" : "") />

                                </div>

                            </div>

                        </div>

                    </div>


                    <!-- ========================= -->
                    <!-- Product Image -->
                    <!-- ========================= -->

                    <div class="col-lg-4">

                        <h5 class="fw-bold mb-4">
                            Product Image
                        </h5>

                        <div class="image-upload-container">

                            <div id="imagePreview"
                                 class="image-preview">

                                @if (!string.IsNullOrWhiteSpace(Model.ImageUrl))
                                {
                                    <img src="@Model.ImageUrl"
                                         alt="@Model.Name"
                                         id="previewImage" />
                                }
                                else
                                {
                                    <i class="bi bi-image"></i>

                                    <span>
                                        No image available
                                    </span>
                                }

                            </div>


                            <label for="Image"
                                   class="btn btn-outline-primary w-100">

                                <i class="bi bi-upload me-2"></i>
                                Change Image

                            </label>

                            <input type="file"
                                   id="Image"
                                   name="Image"
                                   class="d-none"
                                   accept="image/*" />

                            <small class="text-muted d-block mt-2">
                                Select a new image to replace the current one.
                            </small>

                        </div>

                    </div>

                </div>

            </div>


            <!-- ========================= -->
            <!-- Footer -->
            <!-- ========================= -->

            <div class="card-footer px-lg-5 border-0 bg-white px-4 pb-4">

                <div class="d-flex justify-content-end gap-2">

                    <a asp-action="Details"
                           asp-route-id="@Model.Id"
                           class="btn btn-outline-secondary px-4">

                        Cancel

                    </a>

                    <button type="submit"
                            class="btn btn-primary px-4">

                        <i class="bi bi-check-lg me-2"></i>
                        Save Changes

                    </button>

                </div>

            </div>

        </div>

    </form>

</div>


<style>

    .card {
        border-radius: 18px;
    }

    .form-control,
    .form-select {
        border-radius: 10px;
        padding: 10px 14px;
    }

        .form-control:focus,
        .form-select:focus {
            box-shadow: 0 0 0 .2rem rgba(13, 110, 253, .12);
        }

    .image-upload-container {
        width: 100%;
    }

    .image-preview {
        width: 100%;
        height: 300px;
        border: 2px dashed #dee2e6;
        border-radius: 16px;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        color: #adb5bd;
        margin-bottom: 15px;
        overflow: hidden;
    }

        .image-preview i {
            font-size: 4rem;
            margin-bottom: 10px;
        }

        .image-preview span {
            font-size: 0.9rem;
        }

        .image-preview img {
            width: 100%;
            height: 100%;
            object-fit: contain;
        }

    .status-box {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 16px 18px;
        background: #f8f9fa;
        border-radius: 12px;
    }

    .form-check-input {
        width: 2.8em;
        height: 1.4em;
        cursor: pointer;
    }

    .btn {
        border-radius: 10px;
    }

</style>


@section Scripts {

    <script>

        const imageInput = document.getElementById("Image");
        const imagePreview = document.getElementById("imagePreview");

        imageInput.addEventListener("change", function () {

            const file = this.files[0];

            if (!file)
                return;

            const reader = new FileReader();

            reader.onload = function (event) {

                imagePreview.innerHTML = `
                    <img src="${event.target.result}"
                         alt="Product Image" />
                `;

            };

            reader.readAsDataURL(file);

        });

    </script>

}