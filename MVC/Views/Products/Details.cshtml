
@*
    For more information on enabling MVC for empty projects, visit https://go.microsoft.com/fwlink/?LinkID=397860
*@
@model Application.Dtos.Products.ProductDto

@{
    ViewData["Title"] = "Product Details";
}

<div class="container-fluid py-4">

    ```
    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-3">
        <div>
            <div class="d-flex align-items-center mb-1 gap-2">
                <a asp-action="Index"
                       class="text-decoration-none text-secondary">
                    Products
                </a>

                <span class="text-secondary">/</span>

                <span class="text-muted">Details</span>
            </div>

            <h2 class="fw-bold mb-0">@Model.Name</h2>
        </div>

        <div class="d-flex gap-2">
            <a asp-action="Edit"
                   asp-route-id="@Model.Id"
                   class="btn btn-primary px-4">
                <i class="bi bi-pencil me-2"></i>
                Edit
            </a>

            <a asp-action="Index"
                   class="btn btn-outline-secondary px-4">
                <i class="bi bi-arrow-left me-2"></i>
                Back
            </a>
        </div>
    </div>


    <!-- Main Product Card -->
    <div class="card overflow-hidden border-0 shadow-sm">

        <div class="row g-0">

            <!-- Product Image -->
            <div class="col-lg-4 bg-light d-flex align-items-center justify-content-center p-5">

                <div class="product-image-container">

                    @if (!string.IsNullOrWhiteSpace(Model.ImageUrl))
                    {
                        <img src="@Model.ImageUrl"
                             alt="@Model.Name"
                             class="img-fluid product-image" />
                    }
                    else
                    {
                        <div class="product-placeholder">
                            <i class="bi bi-image"></i>
                            <span>No Image</span>
                        </div>
                    }

                </div>

            </div>


            <!-- Product Information -->
            <div class="col-lg-8">

                <div class="p-lg-5 p-4">

                    <!-- Product Name + Status -->
                    <div class="d-flex justify-content-between align-items-start mb-4 flex-wrap gap-3">

                        <div>
                            <span class="text-muted small">
                                Product
                            </span>

                            <h3 class="fw-bold mb-1">
                                @Model.Name
                            </h3>

                            <div class="text-muted small">
                                ID: @Model.Id
                            </div>
                        </div>


                        @if (Model.IsActive)
                        {
                            <span class="badge rounded-pill bg-success-subtle text-success px-3 py-2">
                                <i class="bi bi-check-circle me-1"></i>
                                Active
                            </span>
                        }
                        else
                        {
                            <span class="badge rounded-pill bg-danger-subtle text-danger px-3 py-2">
                                <i class="bi bi-x-circle me-1"></i>
                                Inactive
                            </span>
                        }

                    </div>


                    <!-- Price & Stock -->
                    <div class="row g-3 mb-4">

                        <!-- Selling Price -->
                        <div class="col-md-6">

                            <div class="info-card">

                                <div class="icon-box price-icon">
                                    <i class="bi bi-currency-dollar"></i>
                                </div>

                                <div>
                                    <div class="text-muted small">
                                        Selling Price
                                    </div>

                                    <div class="fs-4 fw-bold">
                                        @Model.SellingPrice.ToString("N2")
                                    </div>
                                </div>

                            </div>

                        </div>


                        <!-- Stock -->
                        <div class="col-md-6">

                            <div class="info-card">

                                <div class="icon-box stock-icon">
                                    <i class="bi bi-box-seam"></i>
                                </div>

                                <div>
                                    <div class="text-muted small">
                                        Total Quantity
                                    </div>

                                    <div class="fs-4 fw-bold">
                                        @Model.TotalQuantity
                                    </div>
                                </div>

                            </div>

                        </div>

                    </div>


                    <!-- Details -->
                    <div class="border-top pt-4">

                        <h5 class="fw-bold mb-4">
                            Product Information
                        </h5>

                        <div class="row g-4">

                            <!-- Barcode -->
                            <div class="col-md-6">

                                <div class="detail-item">

                                    <span class="detail-label">
                                        <i class="bi bi-upc-scan me-2"></i>
                                        Barcode
                                    </span>

                                    <span class="detail-value">
                                        @(string.IsNullOrWhiteSpace(Model.Barcode)
                                            ? "Not available"
                                            : Model.Barcode)
                                    </span>

                                </div>

                            </div>


                            <!-- Brand -->
                            <div class="col-md-6">

                                <div class="detail-item">

                                    <span class="detail-label">
                                        <i class="bi bi-tags me-2"></i>
                                        Brand
                                    </span>

                                    <span class="detail-value text-truncate"
                                          title="@Model.BrandId">
                                        @Model.BrandId
                                    </span>

                                </div>

                            </div>


                            <!-- Category -->
                            <div class="col-md-6">

                                <div class="detail-item">

                                    <span class="detail-label">
                                        <i class="bi bi-grid me-2"></i>
                                        Category
                                    </span>

                                    <span class="detail-value text-truncate"
                                          title="@Model.CategoryId">
                                        @Model.CategoryId
                                    </span>

                                </div>

                            </div>


                            <!-- Product Status -->
                            <div class="col-md-6">

                                <div class="detail-item">

                                    <span class="detail-label">
                                        <i class="bi bi-toggle-on me-2"></i>
                                        Status
                                    </span>

                                    @if (Model.IsActive)
                                    {
                                        <span class="badge bg-success-subtle text-success">
                                            Active
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger-subtle text-danger">
                                            Inactive
                                        </span>
                                    }

                                </div>

                            </div>

                        </div>

                    </div>

                </div>

            </div>

        </div>

    </div>
    ```

</div>

<style>

    .product-image-container {
        width: 100%;
        max-width: 360px;
        height: 360px;

        display: flex;
        align-items: center;
        justify-content: center;
    }

    .product-image {
        max-width: 100%;
        max-height: 100%;
        object-fit: contain;

        border-radius: 16px;
    }

    .product-placeholder {
        width: 100%;
        height: 100%;

        border: 2px dashed #dee2e6;
        border-radius: 16px;

        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;

        color: #adb5bd;
        gap: 10px;
    }

    .product-placeholder i {
        font-size: 4rem;
    }

    .product-placeholder span {
        font-size: 0.95rem;
    }

    .info-card {
        display: flex;
        align-items: center;
        gap: 16px;

        padding: 20px;

        background: #f8f9fa;
        border-radius: 14px;

        height: 100%;
    }

    .icon-box {
        width: 48px;
        height: 48px;

        border-radius: 12px;

        display: flex;
        align-items: center;
        justify-content: center;

        font-size: 1.3rem;
    }

    .price-icon {
        background: #e7f1ff;
        color: #0d6efd;
    }

    .stock-icon {
        background: #e9f7ef;
        color: #198754;
    }

    .detail-item {
        display: flex;
        flex-direction: column;
        gap: 7px;

        padding-bottom: 14px;
        border-bottom: 1px solid #f0f0f0;
    }

    .detail-label {
        color: #6c757d;
        font-size: 0.85rem;
        font-weight: 500;
    }

    .detail-value {
        font-weight: 600;
        color: #212529;
    }

    .card {
        border-radius: 18px;
    }

    .btn {
        border-radius: 10px;
    }

    @@media (max-width: 991px) {

        .product-image-container {
            height: 300px;
        }

    }

</style>
