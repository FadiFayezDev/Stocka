@using Application.Dtos.Products
@model ProductDto

@{
    ViewData["Title"] = "تفاصيل المنتج";
}

<div class="page-head">
    <div class="page-head__text">
        <nav aria-label="breadcrumb" class="breadcrumb-nav">
            <ol class="breadcrumb mb-1">
                <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">الرئيسية</a></li>
                <li class="breadcrumb-item"><a asp-action="Index">المنتجات</a></li>
                <li class="breadcrumb-item active" aria-current="page">التفاصيل</li>
            </ol>
        </nav>
        <h1 class="page-head__title">@Model.Name</h1>
        <p class="page-head__subtitle text-muted mb-0">معلومات تفصيلية عن المنتج وحالته في المخزون</p>
    </div>

    <div class="page-head__actions">
        <div class="d-flex gap-2 flex-wrap">
            <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary px-4">
                <i class="bi bi-pencil"></i> تعديل
            </a>
            <a asp-action="Delete" asp-route-id="@Model.Id" class="btn btn-outline-danger px-4">
                <i class="bi bi-trash"></i> حذف
            </a>
            <a asp-action="Index" class="btn btn-outline-secondary px-4">
                <i class="bi bi-arrow-right"></i> رجوع
            </a>
        </div>
    </div>
</div>

<div class="card overflow-hidden border-0 shadow-sm details-card">
    <div class="row g-0">
        <div class="col-lg-4 details-media">
            @if (!string.IsNullOrWhiteSpace(Model.ImageUrl))
            {
                <img src="@Model.ImageUrl" alt="@Model.Name" class="details-image" />
            }
            else
            {
                <div class="details-placeholder">
                    <i class="bi bi-image"></i>
                    <span>لا توجد صورة لهذا المنتج</span>
                </div>
            }
        </div>

        <div class="col-lg-8">
            <div class="p-lg-5 p-4">
                <div class="d-flex justify-content-between align-items-start mb-4 flex-wrap gap-3">
                    <div>
                        <span class="text-muted small">المنتج</span>
                        <h3 class="fw-bold mb-1">@Model.Name</h3>
                        <div class="text-muted small">
                            <i class="bi bi-hash"></i> @Model.Id
                        </div>
                    </div>

                    @if (Model.IsActive)
                    {
                        <span class="badge rounded-pill bg-success-subtle text-success px-3 py-2">
                            <i class="bi bi-check-circle me-1"></i> نشط
                        </span>
                    }
                    else
                    {
                        <span class="badge rounded-pill bg-danger-subtle text-danger px-3 py-2">
                            <i class="bi bi-x-circle me-1"></i> غير نشط
                        </span>
                    }
                </div>

                <div class="row g-3 mb-4">
                    <div class="col-md-6">
                        <div class="info-card">
                            <div class="icon-box price-icon"><i class="bi bi-currency-exchange"></i></div>
                            <div>
                                <div class="text-muted small">سعر البيع</div>
                                <div class="fs-4 fw-bold">@Model.SellingPrice.ToString("N2") <small class="fs-6 text-muted">ج.م</small></div>
                            </div>
                        </div>
                    </div>

                    <div class="col-md-6">
                        <div class="info-card">
                            <div class="icon-box stock-icon"><i class="bi bi-box-seam"></i></div>
                            <div>
                                <div class="text-muted small">الكمية المتاحة</div>
                                <div class="fs-4 fw-bold">@Model.TotalQuantity</div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="border-top pt-4">
                    <h5 class="fw-bold mb-4">معلومات إضافية</h5>
                    <div class="row g-4">
                        <div class="col-md-6">
                            <div class="detail-item">
                                <span class="detail-label"><i class="bi bi-upc-scan me-2"></i>الباركود</span>
                                <span class="detail-value">
                                    @(string.IsNullOrWhiteSpace(Model.Barcode) ? "غير متوفر" : Model.Barcode)
                                </span>
                            </div>
                        </div>

                        <div class="col-md-6">
                            <div class="detail-item">
                                <span class="detail-label"><i class="bi bi-tags me-2"></i>الفئة</span>
                                <span class="detail-value text-truncate">@(ViewData["CategoryName"])</span>
                            </div>
                        </div>

                        <div class="col-md-6">
                            <div class="detail-item">
                                <span class="detail-label"><i class="bi bi-building me-2"></i>العلامة التجارية</span>
                                <span class="detail-value text-truncate">@(ViewData["BrandName"])</span>
                            </div>
                        </div>

                        <div class="col-md-6">
                            <div class="detail-item">
                                <span class="detail-label"><i class="bi bi-toggle-on me-2"></i>الحالة</span>
                                @if (Model.IsActive)
                                {
                                    <span class="badge bg-success-subtle text-success">نشط</span>
                                }
                                else
                                {
                                    <span class="badge bg-danger-subtle text-danger">غير نشط</span>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .page-head {
        display: flex;
        align-items: flex-end;
        justify-content: space-between;
        gap: 16px;
        flex-wrap: wrap;
        margin-bottom: 20px;
    }

    .page-head__title {
        font-size: 1.5rem;
        font-weight: 700;
        margin-bottom: 2px;
    }

    .page-head__subtitle {
        font-size: 0.875rem;
    }

    .breadcrumb-nav .breadcrumb {
        background: transparent;
        padding: 0;
        margin: 0;
        font-size: 0.8125rem;
    }

    .breadcrumb-nav .breadcrumb a {
        color: var(--text-2);
        text-decoration: none;
    }

    .breadcrumb-nav .breadcrumb a:hover {
        color: var(--accent);
    }

    .details-card {
        border-radius: var(--radius-lg);
        overflow: hidden;
    }

    .details-media {
        background: var(--surface-muted);
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 40px;
        min-height: 360px;
    }

    .details-image {
        max-width: 100%;
        max-height: 340px;
        object-fit: contain;
        border-radius: 16px;
    }

    .details-placeholder {
        width: 100%;
        height: 280px;
        border: 2px dashed var(--border-strong);
        border-radius: 16px;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        color: var(--text-3);
        gap: 10px;
    }

    .details-placeholder i {
        font-size: 4rem;
    }

    .info-card {
        display: flex;
        align-items: center;
        gap: 16px;
        padding: 20px;
        background: var(--surface-muted);
        border: 1px solid var(--border);
        border-radius: 14px;
        height: 100%;
    }

    .icon-box {
        width: 48px;
        height: 48px;
        border-radius: 12px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.3rem;
        flex: 0 0 auto;
    }

    .price-icon {
        background: #e7f1ff;
        color: #0d6efd;
    }

    .stock-icon {
        background: var(--accent-soft);
        color: var(--accent);
    }

    .detail-item {
        display: flex;
        flex-direction: column;
        gap: 7px;
        padding-bottom: 14px;
        border-bottom: 1px solid var(--border);
    }

    .detail-label {
        color: var(--text-2);
        font-size: 0.85rem;
        font-weight: 500;
    }

    .detail-value {
        font-weight: 600;
        color: var(--text-1);
    }

    @@media (max-width: 991px) {
        .details-media {
            min-height: 260px;
            padding: 24px;
        }
    }
</style>