@functions {
    string CurrentController => ViewContext.RouteData.Values["controller"]?.ToString() ?? string.Empty;

    string CurrentAction => ViewContext.RouteData.Values["action"]?.ToString() ?? string.Empty;

    bool IsCurrent(string controller, string? action = null) =>
        string.Equals(CurrentController, controller, StringComparison.OrdinalIgnoreCase) &&
        (string.IsNullOrEmpty(action) || string.Equals(CurrentAction, action, StringComparison.OrdinalIgnoreCase));

    // Returns "is-active aria-current=\"page\"" (or empty) for a nav item.
    string ActiveAttrs(string controller, string? action = null) =>
        IsCurrent(controller, action) ? "is-active aria-current=\"page\"" : string.Empty;

    // Returns "is-open" when any of the given controllers is the current one,
    // so the group containing the active page stays expanded.
    string GroupState(params string[] controllers) =>
        controllers.Any(c => string.Equals(CurrentController, c, StringComparison.OrdinalIgnoreCase))
            ? "is-open"
            : string.Empty;
}

<aside class="app-sidebar" id="appSidebar" aria-label="Primary">
