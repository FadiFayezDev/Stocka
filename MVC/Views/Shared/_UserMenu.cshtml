@using Microsoft.AspNetCore.Identity
@using Infrastructure.Identity

@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager

@{
    var isSignedIn = SignInManager.IsSignedIn(User);
    var displayName = "Guest";
    var initial = "G";

    if (isSignedIn)
    {
        var user = await UserManager.GetUserAsync(User);
        if (user != null)
        {
            var fullName = $"{user.FirstName} {user.LastName}".Trim();
            displayName = string.IsNullOrWhiteSpace(fullName)
                ? (user.Email ?? user.UserName ?? "User")
                : fullName;
            initial = displayName[..1].ToUpperInvariant();
        }
    }
}

<div class="dropdown user-menu">
    <button class="user-menu__btn"
            type="button"
            data-bs-toggle="dropdown"
            data-bs-display="static"
            aria-expanded="false"
            aria-label="Account menu">
        <span class="user-menu__avatar" aria-hidden="true">@initial</span>
        <span class="user-menu__meta d-none d-sm-inline-flex">
            <span class="user-menu__name">@displayName</span>
        </span>
        <i class="bi bi-chevron-down user-menu__caret" aria-hidden="true"></i>
    </button>

    <div class="dropdown-menu user-menu__menu">
        <h6 class="dropdown-header">@displayName</h6>

        <a class="dropdown-item" asp-area="Identity" asp-page="/Account/Manage/Index">
            <i class="bi bi-person" aria-hidden="true"></i>
            Profile
        </a>
        <a class="dropdown-item" href="#">
            <i class="bi bi-gear" aria-hidden="true"></i>
            Settings
        </a>

        <div class="dropdown-divider"></div>

        @if (isSignedIn)
        {
            <form id="logoutForm"
                  asp-area="Identity"
                  asp-page="/Account/Logout"
                  asp-route-returnUrl="@Url.Action("Index", "Home", new { area = "" })"
                  method="post"
                  class="mb-0">
                <button type="submit" class="dropdown-item">
                    <i class="bi bi-box-arrow-right" aria-hidden="true"></i>
                    Sign out
                </button>
            </form>
        }
        else
        {
            <a class="dropdown-item" id="login" asp-area="Identity" asp-page="/Account/Login">
                <i class="bi bi-box-arrow-in-right" aria-hidden="true"></i>
                Sign in
            </a>
        }
    </div>
</div>
