@model MVC.Models.Purchases.PurchaseListModel
@{
    ViewData["Title"] ??= "أوامر الشراء";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h4 class="mb-1">أوامر الشراء</h4>
        <span class="text-secondary small">سجل أوامر الشراء وموقف التوريد لكل أمر</span>
    </div>
    <a asp-controller="Purchases" asp-action="Create" class="btn btn-primary">
        <i class="bi bi-plus-lg"></i> أمر شراء جديد
    </a>
</div>

<div class="row g-3 mb-4">
    <div class="col-md-4">
        <div class="card border-0 shadow-sm">
            <div class="card-body">
                <div class="text-secondary small">عدد الأوامر</div>
                <div class="fs-4 fw-bold">@Model.TotalOrders</div>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card border-0 shadow-sm">
            <div class="card-body">
                <div class="text-secondary small">إجمالي قيمة الأوامر</div>
                <div class="fs-4 fw-bold">@Model.TotalOrdered.ToString("N2") ج.م</div>
            </div>
        </div>
    </div>
</div>

<ul class="nav nav-pills mb-3">
    <li class="nav-item"><a class="nav-link @(string.IsNullOrEmpty(Model.StatusFilter) ? "active" : "")" asp-action="Index">الكل</a></li>
    <li class="nav-item"><a class="nav-link @(Model.StatusFilter == "Ordered" ? "active" : "")" asp-action="Index" asp-route-status="Ordered">قيد التوريد</a></li>
    <li class="nav-item"><a class="nav-link @(Model.StatusFilter == "Completed" ? "active" : "")" asp-action="Index" asp-route-status="Completed">مكتمل</a></li>
    <li class="nav-item"><a class="nav-link @(Model.StatusFilter == "Cancelled" ? "active" : "")" asp-action="Index" asp-route-status="Cancelled">ملغي</a></li>
</ul>

<div class="card border-0 shadow-sm">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>التاريخ</th>
                    <th>المورد</th>
                    <th>الحالة</th>
                    <th class="text-center">الأصناف</th>
                    <th class="text-center">التوريد</th>
                    <th class="text-end">القيمة</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Purchases.Any())
                {
                    <tr>
                        <td colspan="7" class="text-center text-secondary py-5">لا توجد أوامر شراء بعد.</td>
                    </tr>
                }
                else
                {
                    @foreach (var p in Model.Purchases)
                    {
                        <tr>
                            <td>@p.PurchaseDate.ToString("yyyy-MM-dd")</td>
                            <td>@p.SupplierName</td>
                            <td>
                                <span class="badge @(p.Status switch {
                                    "Ordered" => "bg-warning-subtle text-warning",
                                    "Completed" => "bg-success-subtle text-success",
                                    "Cancelled" => "bg-secondary-subtle text-secondary",
                                    _ => "bg-light text-dark" })">
                                    @p.StatusLabel
                                </span>
                            </td>
                            <td class="text-center">@p.ItemCount</td>
                            <td class="text-center" style="min-width: 160px;">
                                @if (p.Status == "Ordered")
                                {
                                    var pct = p.TotalUnits > 0 ? (int)(p.ReceivedUnits * 100.0 / p.TotalUnits) : 0;
                                    <div class="d-flex align-items-center gap-2">
                                        <div class="progress flex-grow-1" style="height: 6px;">
                                            <div class="progress-bar" role="progressbar" style="width: @pct%"></div>
                                        </div>
                                        <small class="text-secondary">@pct%</small>
                                    </div>
                                }
                                else
                                {
                                    <span class="text-secondary small">—</span>
                                }
                            </td>
                            <td class="text-end fw-semibold">@p.TotalAmount.ToString("N2")</td>
                            <td class="text-end">
                                <a asp-action="Details" asp-route-id="@p.Id" class="btn btn-sm btn-outline-primary">التفاصيل</a>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>