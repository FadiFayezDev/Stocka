@using MVC.Models.Warehouses
@model WarehouseIndexModel

@{
    ViewData["Title"] = "المخازن";
}

<div class="warehouses-page">
    <div class="page-head">
        <div class="page-head__text">
            <nav aria-label="breadcrumb" class="breadcrumb-nav">
                <ol class="breadcrumb mb-1">
                    <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">الرئيسية</a></li>
                    <li class="breadcrumb-item active" aria-current="page">المخازن</li>
                </ol>
            </nav>
            <h1 class="page-head__title">المخازن</h1>
            <p class="page-head__subtitle text-muted mb-0">إدارة مخازن البيع (الرفوف) ومخازن التخزين الرئيسية</p>
        </div>
        <div class="page-head__actions d-flex gap-2 flex-wrap">
            <a asp-action="Transfer" class="btn btn-outline-primary">
                <i class="bi bi-arrow-left-right me-1"></i>
                <span>تحويل مخزون</span>
            </a>
            <a asp-action="Create" class="btn btn-primary">
                <i class="bi bi-plus-lg me-1"></i>
                <span>إضافة مخزن</span>
            </a>
        </div>
    </div>

    @if (Model.Warehouses.Count == 0)
    {
        <div class="empty-state card border-0 shadow-sm">
            <div class="card-body text-center py-5">
                <i class="bi bi-buildings fs-1 text-muted"></i>
                <h4 class="mt-3">لا توجد مخازن بعد</h4>
                <p class="text-muted">ابدأ بإنشاء مخزن تخزين رئيسي، ثم مخزن بيع (رفوف المحل) ليتم البيع منه.</p>
                <a asp-action="Create" class="btn btn-primary mt-2">
                    <i class="bi bi-plus-lg me-1"></i> إضافة مخزن
                </a>
            </div>
        </div>
    }
    else
    {
        <div class="row g-4">
            @foreach (var warehouse in Model.Warehouses)
            {
                var type = WarehouseTypeLabels.Parse(warehouse.Type);
                var summary = Model.Summaries.GetValueOrDefault(warehouse.Id);
                var productCount = summary?.ProductCount ?? 0;
                var totalUnits = summary?.TotalUnits ?? 0;
                var branches = Model.BranchNames.TryGetValue(warehouse.Id, out var linkedBranches) ? linkedBranches : new List<string>();
                <div class="col-md-6 col-xl-4">
                    <div class="card border-0 shadow-sm warehouse-card @(warehouse.IsActive ? "" : "warehouse-card--inactive")">
                        <div class="card-body p-4">
                            <div class="d-flex justify-content-between align-items-start gap-2 mb-3">
                                <div class="d-flex align-items-center gap-3">
                                    <div class="warehouse-icon">
                                        <i class="bi @(type == WarehouseTypeLabels.Shop ? "bi-shop" : "bi-box-seam")"></i>
                                    </div>
                                    <div>
                                        <h5 class="mb-1 fw-bold">@warehouse.Name</h5>
                                        <span class="badge @WarehouseTypeLabels.BadgeClass(type)">@WarehouseTypeLabels.Label(type)</span>
                                    </div>
                                </div>
                                @if (!warehouse.IsActive)
                                {
                                    <span class="badge bg-secondary-subtle text-secondary">غير مفعل</span>
                                }
                            </div>

                            @if (!string.IsNullOrWhiteSpace(warehouse.Location))
                            {
                                <p class="mb-1 text-muted small">
                                    <i class="bi bi-geo-alt me-1"></i> @warehouse.Location
                                </p>
                            }
                            @if (!string.IsNullOrWhiteSpace(warehouse.Description))
                            {
                                <p class="mb-3 text-muted small">@warehouse.Description</p>
                            }
                            else
                            {
                                <p class="mb-3"></p>
                            }

                            @if (branches.Count > 0)
                            {
                                <div class="mb-3">
                                    <span class="text-muted small me-1">الفروع المرتبطة:</span>
                                    @foreach (var branch in branches)
                                    {
                                        <span class="badge bg-primary-subtle text-primary border border-primary-subtle me-1">@branch</span>
                                    }
                                </div>
                            }

                            <div class="d-flex gap-3 mb-3">
                                <div class="warehouse-stat">
                                    <span class="warehouse-stat__value">@productCount</span>
                                    <span class="warehouse-stat__label">منتج</span>
                                </div>
                                <div class="warehouse-stat">
                                    <span class="warehouse-stat__value">@totalUnits</span>
                                    <span class="warehouse-stat__label">وحدة</span>
                                </div>
                            </div>

                            @if (type == WarehouseTypeLabels.Shop)
                            {
                                <div class="alert alert-success-subtle py-2 px-3 small mb-0">
                                    <i class="bi bi-cart3 me-1"></i> البيع يتم حصرياً من هذا المخزن (الرفوف).
                                </div>
                            }
                            else
                            {
                                <div class="alert alert-info-subtle py-2 px-3 small mb-0">
                                    <i class="bi bi-arrow-left-right me-1"></i> انقل المنتجات من هنا إلى مخزن البيع ليتم عرضها.
                                </div>
                            }
                        </div>
                        <div class="card-footer border-0 bg-white px-4 py-3 d-flex justify-content-between align-items-center">
                            <a asp-action="Stock" asp-route-id="@warehouse.Id" class="btn btn-sm btn-outline-secondary">
                                <i class="bi bi-box-seam me-1"></i> المحتويات
                            </a>
                            <div class="d-flex gap-2">
                                <a asp-action="Transfer" asp-route-from="@warehouse.Id" class="btn btn-sm btn-outline-primary">
                                    <i class="bi bi-arrow-left-right me-1"></i> تحويل
                                </a>
                                <a asp-action="Edit" asp-route-id="@warehouse.Id" class="btn btn-sm btn-outline-primary">
                                    <i class="bi bi-pencil me-1"></i> تعديل
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>

<style>
    .page-head {
        display: flex;
        align-items: flex-end;
        justify-content: space-between;
        gap: 16px;
        flex-wrap: wrap;
        margin-bottom: 20px;
    }

    .page-head__title {
        font-size: 1.5rem;
        font-weight: 700;
        margin-bottom: 2px;
    }

    .page-head__subtitle {
        font-size: 0.875rem;
    }

    .breadcrumb-nav .breadcrumb {
        background: transparent;
        padding: 0;
        margin: 0;
        font-size: 0.8125rem;
    }

    .breadcrumb-nav .breadcrumb a {
        color: var(--text-2);
        text-decoration: none;
    }

    .breadcrumb-nav .breadcrumb a:hover {
        color: var(--accent);
    }

    .warehouse-card {
        border-radius: var(--radius-lg);
        overflow: hidden;
        transition: box-shadow .2s ease, transform .2s ease;
    }

    .warehouse-card:hover {
        box-shadow: 0 .5rem 1rem rgba(0, 0, 0, .08) !important;
        transform: translateY(-2px);
    }

    .warehouse-card--inactive {
        opacity: .72;
    }

    .warehouse-icon {
        width: 48px;
        height: 48px;
        border-radius: 14px;
        display: flex;
        align-items: center;
        justify-content: center;
        background: var(--surface-muted);
        color: var(--accent);
        font-size: 1.4rem;
    }

    .warehouse-stat {
        display: flex;
        flex-direction: column;
        align-items: center;
        background: var(--surface-muted);
        border-radius: 10px;
        padding: 6px 14px;
    }

    .warehouse-stat__value {
        font-size: 1.05rem;
        font-weight: 700;
        line-height: 1.1;
    }

    .warehouse-stat__label {
        font-size: 0.72rem;
        color: var(--text-2);
    }
</style>