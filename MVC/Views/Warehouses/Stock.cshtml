@using MVC.Models.Warehouses
@model WarehouseStockModel

@{
    ViewData["Title"] = "محتويات المخزن";
    var type = WarehouseTypeLabels.Parse(Model.Warehouse.Type);
}

<div class="warehouse-stock-page">
    <div class="page-head">
        <div class="page-head__text">
            <nav aria-label="breadcrumb" class="breadcrumb-nav">
                <ol class="breadcrumb mb-1">
                    <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">الرئيسية</a></li>
                    <li class="breadcrumb-item"><a asp-action="Index">المخازن</a></li>
                    <li class="breadcrumb-item active" aria-current="page">محتويات المخزن</li>
                </ol>
            </nav>
            <h1 class="page-head__title">@Model.Warehouse.Name</h1>
            <p class="page-head__subtitle text-muted mb-0">
                <span class="badge @WarehouseTypeLabels.BadgeClass(type)">@WarehouseTypeLabels.Label(type)</span>
                @if (!string.IsNullOrWhiteSpace(Model.Warehouse.Location))
                {
                    <span class="ms-2"><i class="bi bi-geo-alt"></i> @Model.Warehouse.Location</span>
                }
            </p>
        </div>
        <div class="page-head__actions d-flex gap-2 flex-wrap">
            <a asp-action="Transfer" asp-route-from="@Model.Warehouse.Id" class="btn btn-primary">
                <i class="bi bi-arrow-left-right me-1"></i>
                <span>تحويل من هذا المخزن</span>
            </a>
            <a asp-action="Index" class="btn btn-outline-secondary">
                <i class="bi bi-arrow-right"></i>
                <span>رجوع للمخازن</span>
            </a>
        </div>
    </div>

    @if (TempData["ErrorMessage"] is string error)
    {
        <div class="alert alert-danger shadow-sm d-flex align-items-center gap-2 py-3" role="alert">
            <i class="bi bi-x-circle-fill"></i>
            <span>@error</span>
        </div>
    }

    <div class="row g-3 mb-4">
        <div class="col-sm-6 col-lg-3">
            <div class="stat-card card border-0 shadow-sm">
                <div class="card-body d-flex align-items-center gap-3">
                    <div class="stat-card__icon bg-success-subtle text-success"><i class="bi bi-box-seam"></i></div>
                    <div>
                        <div class="stat-card__value">@Model.ProductCount</div>
                        <div class="stat-card__label">منتج</div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-sm-6 col-lg-3">
            <div class="stat-card card border-0 shadow-sm">
                <div class="card-body d-flex align-items-center gap-3">
                    <div class="stat-card__icon bg-info-subtle text-primary"><i class="bi bi-layers"></i></div>
                    <div>
                        <div class="stat-card__value">@Model.TotalUnits</div>
                        <div class="stat-card__label">وحدة إجمالاً</div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="card border-0 shadow-sm">
        <div class="card-header bg-white border-0 py-3 px-4 d-flex justify-content-between align-items-center">
            <h5 class="mb-0 fw-bold"><i class="bi bi-list-check"></i> المنتجات في المخزن</h5>
            <input type="search" id="stockSearch" class="form-control form-control-sm" style="max-width: 260px;" placeholder="ابحث بالاسم أو الباركود..." autocomplete="off" />
        </div>

        @if (Model.Items.Count == 0)
        {
            <div class="card-body text-center py-5">
                <i class="bi bi-inboxes fs-1 text-muted"></i>
                <h5 class="mt-3">لا توجد منتجات في هذا المخزن</h5>
                <p class="text-muted">حوّل كمية من المخزن الرئيسي إلى هنا ليُعرض المخزون.</p>
                <a asp-action="Transfer" asp-route-from="@Model.Warehouse.Id" class="btn btn-primary mt-1">
                    <i class="bi bi-arrow-left-right me-1"></i> تحويل إلى هذا المخزن
                </a>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0 stock-table">
                    <thead>
                        <tr>
                            <th class="ps-4">المنتج</th>
                            <th>الباركود</th>
                            <th class="text-center">الكمية</th>
                            <th class="text-end pe-4">تحويل</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model.Items)
                        {
                            <tr data-name="@item.ProductName" data-barcode="@item.Barcode">
                                <td class="ps-4 fw-medium">@item.ProductName</td>
                                <td class="text-muted">@item.Barcode</td>
                                <td class="text-center">
                                    @if (item.Quantity <= 0)
                                    {
                                        <span class="badge bg-danger-subtle text-danger">نفذت</span>
                                    }
                                    else if (item.Quantity <= 5)
                                    {
                                        <span class="badge bg-warning-subtle text-warning">@item.Quantity</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-success-subtle text-success">@item.Quantity</span>
                                    }
                                </td>
                                <td class="text-end pe-4">
                                    <a asp-action="Transfer" asp-route-from="@Model.Warehouse.Id"
                                       class="btn btn-sm btn-outline-primary">تحويل</a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>

@section Scripts {
    <script>
        (function () {
            var input = document.getElementById("stockSearch");
            if (!input) return;
            input.addEventListener("input", function () {
                var q = input.value.trim().toLowerCase();
                document.querySelectorAll(".stock-table tbody tr").forEach(function (tr) {
                    var name = (tr.dataset.name || "").toLowerCase();
                    var barcode = (tr.dataset.barcode || "").toLowerCase();
                    tr.hidden = q !== "" && !name.includes(q) && !barcode.includes(q);
                });
            });
        })();
    </script>
}

<style>
    .page-head {
        display: flex;
        align-items: flex-end;
        justify-content: space-between;
        gap: 16px;
        flex-wrap: wrap;
        margin-bottom: 20px;
    }

    .page-head__title {
        font-size: 1.5rem;
        font-weight: 700;
        margin-bottom: 2px;
    }

    .page-head__subtitle {
        font-size: 0.875rem;
    }

    .breadcrumb-nav .breadcrumb {
        background: transparent;
        padding: 0;
        margin: 0;
        font-size: 0.8125rem;
    }

    .breadcrumb-nav .breadcrumb a {
        color: var(--text-2);
        text-decoration: none;
    }

    .breadcrumb-nav .breadcrumb a:hover {
        color: var(--accent);
    }

    .stat-card {
        border-radius: var(--radius-lg);
    }

    .stat-card__icon {
        width: 46px;
        height: 46px;
        border-radius: 12px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.3rem;
        flex-shrink: 0;
    }

    .stat-card__value {
        font-size: 1.35rem;
        font-weight: 700;
        line-height: 1.1;
    }

    .stat-card__label {
        font-size: 0.8rem;
        color: var(--text-2);
    }

    .stock-table th {
        font-size: 0.78rem;
        color: var(--text-2);
        font-weight: 600;
        white-space: nowrap;
    }
</style>