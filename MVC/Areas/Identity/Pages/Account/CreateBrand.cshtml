@page
@model MVC.Areas.Identity.Pages.Account.CreateBrandModel
@{
    ViewData["Title"] = "Create Brand";
}

<h1>@ViewData["Title"]</h1>

<div class="row">
    <div class="col-md-4">
        <form method="post">
            <h2>Create your brand to get started.</h2>
            <hr />
            <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>
            <input type="hidden" asp-for="UserId" />
            <input type="hidden" asp-for="ReturnUrl" />
            <div class="form-floating mb-3">
                <input asp-for="Input.BrandName" class="form-control" aria-required="true" placeholder="My Store" />
                <label asp-for="Input.BrandName">Brand Name</label>
                <span asp-validation-for="Input.BrandName" class="text-danger"></span>
            </div>
            <div class="form-floating mb-3">
                <input asp-for="Input.Slug" class="form-control" placeholder="my-store" />
                <label asp-for="Input.Slug">Slug</label>
                <span asp-validation-for="Input.Slug" class="text-danger"></span>
            </div>
            <button id="createBrandSubmit" type="submit" class="w-100 btn btn-lg btn-primary">Create Brand and Continue</button>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
