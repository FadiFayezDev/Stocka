@model IEnumerable<WarehouseDto>
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container-fluid py-4">
    <h2>Search Warehouses by Name</h2>
    @if (ViewBag.NotFound != null)
    {
        <div class="alert alert-warning">@ViewBag.NotFound</div>
    }
    @if (ViewBag.Error != null)
    {
        <div class="alert alert-danger">@ViewBag.Error</div>
    }

    <form method="get" class="row g-2 mb-4" asp-area="Inventory" asp-controller="Warehouses" asp-action="SearchByName">
        <div class="col-md-6">
            <input type="text" class="form-control" name="name" placeholder="Warehouse name (contains)" value="@Context.Request.Query["name"]" />
        </div>
        <div class="col-auto">
            <button type="submit" class="btn btn-primary">Search</button>
        </div>
    </form>

    @if (Model != null && Model.Any())
    {
        <div class="card border-0 shadow-sm">
            <div class="card-body p-0">
                <table class="table-hover mb-0 table align-middle">
                    <thead class="table-light">
                        <tr><th class="ps-4">Name</th><th>Location</th><th>Status</th><th class="pe-4"></th></tr>
                    </thead>
                    <tbody>
                        @foreach (var warehouse in Model)
                        {
                            <tr>
                                <td class="ps-4 fw-semibold">@warehouse.Name</td>
                                <td>@warehouse.Location</td>
                                <td><span class="badge text-bg-@(warehouse.IsActive ? "success" : "secondary")">@(warehouse.IsActive ? "Active" : "Inactive")</span></td>
                                <td class="pe-4 text-end">
                                    <a class="btn btn-sm btn-outline-primary" asp-area="Inventory" asp-controller="Warehouses" asp-action="Details" asp-route-id="@warehouse.Id">Details</a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
    else if (!string.IsNullOrWhiteSpace(Context.Request.Query["name"]))
    {
        <div class="text-muted">No warehouses matched the search.</div>
    }
</div>
