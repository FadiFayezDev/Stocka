@model Inventory.Contracts.DTOs.Batch.BatchDetailsDto
@using Inventory.Contracts.DTOs.StockMovement
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    var movements = (IEnumerable<StockMovementDto>?)ViewBag.Movements;
    var warehouses = (PaginatedResult<WarehouseDto>?)ViewBag.ActiveWarehouses;
}

<div class="container-fluid py-4">
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="mb-1">Batch Details</h2>
            <p class="text-muted mb-0">
                Product @Model.ProductId &middot; Purchase item @Model.PurchaseItemId
                @(Model.IsExhausted ? " &middot; fully allocated" : string.Empty)
            </p>
        </div>
        <a class="btn btn-outline-primary" asp-area="Inventory" asp-controller="Batches" asp-action="Index">Back to batches</a>
    </div>

    <div class="row g-4 mb-4">
        <div class="col-lg-6">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-header bg-white"><strong>Quantities (distinct concepts)</strong></div>
                <div class="card-body">
                    <dl class="row mb-0">
                        <dt class="col-sm-6">Initial received</dt><dd class="col-sm-6">@Model.InitialQuantity</dd>
                        <dt class="col-sm-6">Unallocated (RemainingQuantity)</dt><dd class="col-sm-6">@Model.RemainingQuantity</dd>
                        <dt class="col-sm-6">Ever allocated</dt><dd class="col-sm-6">@Model.AllocatedQuantity</dd>
                        <dt class="col-sm-6">Currently in warehouses</dt><dd class="col-sm-6">@Model.QuantityInWarehouses</dd>
                    </dl>
                </div>
            </div>
        </div>
        <div class="col-lg-6">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-header bg-white"><strong>Cost (recorded batch unit cost)</strong></div>
                <div class="card-body">
                    <dl class="row mb-0">
                        <dt class="col-sm-6">Unit cost</dt><dd class="col-sm-6">@Model.UnitCost.ToString("N2")</dd>
                        <dt class="col-sm-6">Initial total cost</dt><dd class="col-sm-6">@Model.InitialTotalCost.ToString("N2")</dd>
                        <dt class="col-sm-6">Unallocated value</dt><dd class="col-sm-6">@Model.RemainingValue.ToString("N2")</dd>
                        <dt class="col-sm-6">Received at</dt><dd class="col-sm-6">@Model.CreatedAt.ToString("yyyy-MM-dd HH:mm") UTC</dd>
                    </dl>
                    <small class="text-muted">Traceable recorded costs only â€” no FIFO / weighted-average valuation policy is approved yet.</small>
                </div>
            </div>
        </div>
    </div>

    <div class="row g-4 mb-4">
        <div class="col-lg-6">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-header bg-white"><strong>Allocate stock to a warehouse</strong></div>
                <div class="card-body">
                    <form asp-area="Inventory" asp-controller="Stock" asp-action="Allocate" method="post">
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-2"></div>
                        <input type="hidden" name="BatchId" value="@Model.Id" />
                        <div class="row g-2 align-items-end">
                            <div class="col-sm-7">
                                <label class="form-label">Warehouse</label>
                                <select name="WarehouseId" class="form-select" required>
                                    @foreach (var w in warehouses?.Items ?? Enumerable.Empty<WarehouseDto>())
                                    {
                                        <option value="@w.Id">@w.Name (@w.Location)</option>
                                    }
                                </select>
                            </div>
                            <div class="col-sm-3">
                                <label class="form-label">Quantity</label>
                                <input type="number" name="Quantity" class="form-control" min="1" max="@Model.RemainingQuantity" required />
                            </div>
                            <div class="col-sm-2"><button type="submit" class="btn btn-primary w-100">Allocate</button></div>
                        </div>
                        <small class="text-muted">Max @(Model.RemainingQuantity) unallocated units. Placement records a PurchaseIn movement.</small>
                    </form>
                </div>
            </div>
        </div>
        <div class="col-lg-6">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-header bg-white"><strong>Transfer between warehouses</strong></div>
                <div class="card-body">
                    <form asp-area="Inventory" asp-controller="Stock" asp-action="Transfer" method="post">
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-2"></div>
                        <input type="hidden" name="BatchId" value="@Model.Id" />
                        <div class="row g-2 align-items-end">
                            <div class="col-sm-5">
                                <label class="form-label">Source</label>
                                <select name="SourceWarehouseId" class="form-select" required>
                                    @foreach (var w in warehouses?.Items ?? Enumerable.Empty<WarehouseDto>())
                                    {
                                        <option value="@w.Id">@w.Name</option>
                                    }
                                </select>
                            </div>
                            <div class="col-sm-5">
                                <label class="form-label">Destination</label>
                                <select name="DestinationWarehouseId" class="form-select" required>
                                    @foreach (var w in warehouses?.Items ?? Enumerable.Empty<WarehouseDto>())
                                    {
                                        <option value="@w.Id">@w.Name</option>
                                    }
                                </select>
                            </div>
                            <div class="col-sm-2">
                                <label class="form-label">Quantity</label>
                                <input type="number" name="Quantity" class="form-control" min="1" required />
                            </div>
                        </div>
                        <div class="mt-2"><input type="text" name="Reason" class="form-control" placeholder="Reason (optional), max 300 chars" maxlength="300" /></div>
                        <small class="text-muted">Both legs (out + in) commit together as one operation.</small>
                    </form>
                </div>
            </div>
        </div>
    </div>

    <div class="row g-4 mb-4">
        <div class="col-md-6">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-header bg-white"><strong>Record sale (out)</strong></div>
                <div class="card-body">
                    <form asp-area="Inventory" asp-controller="Stock" asp-action="Sale" method="post">
                        <input type="hidden" name="BatchId" value="@Model.Id" />
                        <div class="row g-2 align-items-end">
                            <div class="col-sm-4"><input type="number" name="Quantity" class="form-control" min="1" placeholder="Quantity" required /></div>
                            <div class="col-sm-5"><input type="text" name="OrderReferenceId" class="form-control" placeholder="Order reference (optional Guid)" /></div>
                            <div class="col-sm-3"><button type="submit" class="btn btn-warning w-100">Sale out</button></div>
                        </div>
                        <div class="mt-2"><input type="text" name="Reason" class="form-control" placeholder="Reason (optional)" maxlength="300" /></div>
                    </form>
                </div>
            </div>
        </div>
        <div class="col-md-6">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-header bg-white"><strong>Record customer return (in)</strong></div>
                <div class="card-body">
                    <form asp-area="Inventory" asp-controller="Stock" asp-action="Return" method="post">
                        <input type="hidden" name="BatchId" value="@Model.Id" />
                        <div class="row g-2 align-items-end">
                            <div class="col-sm-4"><input type="number" name="Quantity" class="form-control" min="1" placeholder="Quantity" required /></div>
                            <div class="col-sm-5"><input type="text" name="OrderReferenceId" class="form-control" placeholder="Original order (optional Guid)" /></div>
                            <div class="col-sm-3"><button type="submit" class="btn btn-success w-100">Return in</button></div>
                        </div>
                        <div class="mt-2"><input type="text" name="Reason" class="form-control" placeholder="Reason (optional)" maxlength="300" /></div>
                    </form>
                </div>
            </div>
        </div>
        <div class="col-md-6">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-header bg-white"><strong>Physical count adjustment</strong></div>
                <div class="card-body">
                    <form asp-area="Inventory" asp-controller="Stock" asp-action="Adjust" method="post">
                        <input type="hidden" name="BatchId" value="@Model.Id" />
                        <div class="row g-2 align-items-end">
                            <div class="col-sm-5"><input type="number" name="WarehouseId" class="form-control" placeholder="Warehouse (store first)" hidden /></div>
                            <div class="col-sm-4">
                                <label class="form-label">Warehouse</label>
                                <select name="WarehouseId" class="form-select" required>
                                    @foreach (var w in warehouses?.Items ?? Enumerable.Empty<WarehouseDto>())
                                    {
                                        <option value="@w.Id">@w.Name</option>
                                    }
                                </select>
                            </div>
                            <div class="col-sm-3"><input type="number" name="CountedQuantity" class="form-control" min="0" placeholder="Counted" required /></div>
                        </div>
                        <div class="mt-2"><input type="text" name="Reason" class="form-control" placeholder="Reason (required for adjustments)" maxlength="300" required /></div>
                    </form>
                </div>
            </div>
        </div>
        <div class="col-md-6">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-header bg-white"><strong>Damaged stock write-off</strong></div>
                <div class="card-body">
                    <form asp-area="Inventory" asp-controller="Stock" asp-action="Damage" method="post">
                        <input type="hidden" name="BatchId" value="@Model.Id" />
                        <div class="row g-2 align-items-end">
                            <div class="col-sm-4">
                                <label class="form-label">Warehouse</label>
                                <select name="WarehouseId" class="form-select" required>
                                    @foreach (var w in warehouses?.Items ?? Enumerable.Empty<WarehouseDto>())
                                    {
                                        <option value="@w.Id">@w.Name</option>
                                    }
                                </select>
                            </div>
                            <div class="col-sm-3"><input type="number" name="Quantity" class="form-control" min="1" placeholder="Quantity" required /></div>
                            <div class="col-sm-3"><input type="text" name="ReferenceId" class="form-control" placeholder="Ref (optional Guid)" /></div>
                            <div class="col-sm-2"><button type="submit" class="btn btn-danger w-100">Write off</button></div>
                        </div>
                        <div class="mt-2"><input type="text" name="Reason" class="form-control" placeholder="Damage description (required)" maxlength="300" required /></div>
                    </form>
                </div>
            </div>
        </div>
    </div>

    <div class="card border-0 shadow-sm">
        <div class="card-header bg-white"><strong>Movement history (audit trail)</strong></div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table-hover mb-0 table align-middle">
                    <thead class="table-light">
                        <tr>
                            <th class="ps-4">Date (UTC)</th>
                            <th>Type</th>
                            <th>Quantity</th>
                            <th>Warehouse</th>
                            <th>Reference</th>
                            <th>Reason</th>
                            <th class="pe-4 text-end">Correct</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (movements != null && movements.Any())
                        {
                            @foreach (var m in movements)
                            {
                                var typeNames = new Dictionary<int, string>
                                {
                                    { 0, "PurchaseIn" }, { 1, "SaleOut" }, { 2, "TransferIn" }, { 3, "TransferOut" },
                                    { 4, "AdjustmentIn" }, { 5, "AdjustmentOut" }, { 6, "OrderReturn" }
                                };
                                var transferLeg = m.MovementType == 2 || m.MovementType == 3;
                                <tr>
                                    <td class="ps-4">@m.CreatedAt.ToString("yyyy-MM-dd HH:mm")</td>
                                    <td><span class="badge text-bg-@(m.MovementType == 0 || m.MovementType == 2 || m.MovementType == 4 || m.MovementType == 6 ? "success" : "danger")">@typeNames[m.MovementType]</span></td>
                                    <td>@m.Quantity</td>
                                    <td><small>@m.WarehouseId</small></td>
                                    <td><small>@(m.ReferenceId?.ToString() ?? "-")</small></td>
                                    <td><small>@m.Reason</small></td>
                                    <td class="pe-4 text-end">
                                        @if (!transferLeg)
                                        {
                                            <form asp-area="Inventory" asp-controller="Stock" asp-action="ReverseMovement" asp-route-id="@m.Id" method="post" class="d-inline-flex gap-1">
                                                <input type="hidden" name="batchId" value="@Model.Id" />
                                                <input type="text" name="reason" class="form-control form-control-sm" style="max-width: 170px;" placeholder="Correction reason" required maxlength="290" />
                                                <button type="submit" class="btn btn-sm btn-outline-danger" title="Appends an opposite, auditable correction movement">Reverse</button>
                                            </form>
                                        }
                                        else
                                        {
                                            <small class="text-muted">counter-transfer required</small>
                                        }
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr><td colspan="7" class="py-5 text-center text-muted">No movements recorded for this batch yet.</td></tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
    <div class="mb-5"></div>
</div>
