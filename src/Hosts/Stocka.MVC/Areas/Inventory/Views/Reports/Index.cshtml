@model Inventory.Contracts.DTOs.Reports.InventorySummaryDto
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    var totals = (IEnumerable<MovementTypeTotalsDto>?)ViewBag.MovementTotals;
    string[] typeNames = { "PurchaseIn", "SaleOut", "TransferIn", "TransferOut", "AdjustmentIn", "AdjustmentOut", "OrderReturn" };
}

<div class="container-fluid py-4">
    <h2 class="mb-1">Inventory Reports</h2>
    <p class="text-muted mb-4">Brand-scoped rollup, generated @Model.GeneratedAtUtc.ToString("yyyy-MM-dd HH:mm") UTC.</p>

    <div class="row g-3 mb-4">
        <div class="col-md-3"><div class="card border-0 shadow-sm"><div class="card-body"><h6 class="text-muted mb-1">Warehouses</h6><h3 class="mb-0">@Model.TotalWarehouses <small class="fs-6 text-success">(@Model.ActiveWarehouses active)</small></h3></div></div></div>
        <div class="col-md-3"><div class="card border-0 shadow-sm"><div class="card-body"><h6 class="text-muted mb-1">Batches</h6><h3 class="mb-0">@Model.TotalBatches <small class="fs-6 text-secondary">(@Model.ExhaustedBatches exhausted)</small></h3></div></div></div>
        <div class="col-md-3"><div class="card border-0 shadow-sm"><div class="card-body"><h6 class="text-muted mb-1">Units in warehouses</h6><h3 class="mb-0">@Model.UnitsInWarehouses</h3><small class="text-muted">raw unit count, not capacity</small></div></div></div>
        <div class="col-md-3"><div class="card border-0 shadow-sm"><div class="card-body"><h6 class="text-muted mb-1">Total unallocated</h6><h3 class="mb-0">@Model.UnallocatedUnits</h3><small class="text-muted">units never placed</small></div></div></div>
        <div class="col-md-6"><div class="card border-0 shadow-sm"><div class="card-body"><h6 class="text-muted mb-1">Total inventory cost (recorded batch unit costs)</h6><h3 class="mb-0">@Model.TotalInventoryCost.ToString("N2")</h3><small class="text-muted">No FIFO / weighted-average valuation policy approved â€” traceable cost data only.</small></div></div></div>
    </div>

    <div class="card border-0 shadow-sm mb-4">
        <div class="card-header bg-white"><strong>Movement totals by type (all time)</strong></div>
        <div class="card-body p-0">
            <table class="table-hover mb-0 table align-middle">
                <thead class="table-light"><tr><th class="ps-4">Type</th><th>Movements</th><th>Total units</th><th>Net signed</th></tr></thead>
                <tbody>
                    @if (totals != null && totals.Any())
                    {
                        @foreach (var t in totals)
                        {
                            <tr>
                                <td class="ps-4"><span class="badge text-bg-@(t.MovementType == 0 || t.MovementType == 2 || t.MovementType == 4 || t.MovementType == 6 ? "success" : "danger")">@typeNames[t.MovementType]</span></td>
                                <td>@t.MovementCount</td>
                                <td>@t.TotalQuantity</td>
                                <td>@t.SignedQuantity</td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr><td colspan="4" class="py-4 text-center text-muted">No movements recorded.</td></tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <div class="d-flex gap-2 flex-wrap">
        <a class="btn btn-outline-primary" asp-area="Inventory" asp-controller="Reports" asp-action="Warehouses">Warehouse reports</a>
        <a class="btn btn-outline-primary" asp-area="Inventory" asp-controller="Reports" asp-action="Products">Zero-stock products</a>
        <a class="btn btn-outline-primary" asp-area="Inventory" asp-controller="Reports" asp-action="Movements">Movement reports</a>
        <a class="btn btn-outline-primary" asp-area="Inventory" asp-controller="Reports" asp-action="Balance">Historical balance</a>
    </div>
    <div class="mb-5"></div>
</div>
