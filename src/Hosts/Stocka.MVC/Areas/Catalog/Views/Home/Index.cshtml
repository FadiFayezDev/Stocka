@using Stocka.MVC.Areas.Catalog.Models
@*
    For more information on enabling MVC for empty projects, visit https://go.microsoft.com/fwlink/?LinkID=397860
*@
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}
@model List<Person>

<div class="container-fluid">
    <table class="table-striped table">
        <thead>
            <tr>
                <th>Id</th>
                <th>Name</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach(var person in Model)
            {
                <tr>
                    <td>@person.Id</td>
                    <td>@person.Name</td>
                    <td>
                        <a class="btn btn-info" asp-area="Catalog" asp-controller="Home" asp-action="Details" asp-route-id="@person.Id">Details</a>
                        <a class="btn btn-primary" asp-area="Catalog" asp-controller="Home" asp-action="Edit" asp-route-id="@person.Id">Edit</a>
                        <a class="btn btn-danger" asp-area="Catalog" asp-controller="Home" asp-action="Delete" asp-route-id="@person.Id">Delete</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
