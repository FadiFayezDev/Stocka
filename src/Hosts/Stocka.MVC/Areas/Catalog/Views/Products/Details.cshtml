@model Catalog.Application.DTOs.Product.ProductDto
@{
    ViewData["Title"] = "Product Details";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <div>
                    <h2 class="mb-1">Product Details</h2>
                    <p class="text-muted mb-0">UseCase: RetrieveProductCommand</p>
                </div>
                <a asp-area="Catalog" asp-controller="Products" asp-action="Index" class="btn btn-light">Back to List</a>
            </div>

            @if (Model == null)
            {
                <div class="alert alert-warning">Product not found.</div>
            }
            else
            {
                <div class="card border-0 shadow-sm">
                    <div class="card-body p-4">
                        @if (!string.IsNullOrWhiteSpace(Model.ImagePath))
                        {
                            <div class="mb-3 text-center">
                                <img src="@Model.ImagePath" alt="@Model.Name" class="img-fluid rounded" style="max-height:300px; object-fit:contain;" />
                            </div>
                        }
                        <div class="row g-3">
                            <div class="col-md-6">
                                <label class="form-label text-muted small mb-1">ID</label>
                                <div class="fw-semibold font-monospace small">@Model.Id</div>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label text-muted small mb-1">Brand ID</label>
                                <div class="fw-semibold font-monospace small">@Model.BrandId</div>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label text-muted small mb-1">Name</label>
                                <div class="fw-semibold fs-5">@Model.Name</div>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label text-muted small mb-1">Category ID</label>
                                <div class="fw-semibold font-monospace small">@Model.CategoryId</div>
                            </div>
                            <div class="col-md-4">
                                <label class="form-label text-muted small mb-1">Barcode</label>
                                <div class="fw-semibold">@Model.Barcode</div>
                            </div>
                            <div class="col-md-4">
                                <label class="form-label text-muted small mb-1">Price</label>
                                <div class="fw-semibold fs-5">@Model.Price.ToString("N2") $</div>
                            </div>
                            <div class="col-md-4">
                                <label class="form-label text-muted small mb-1">Status</label>
                                <div>
                                    @if (Model.IsActive)
                                    {
                                        <span class="badge text-bg-success fs-6">Active</span>
                                    }
                                    else
                                    {
                                        <span class="badge text-bg-secondary fs-6">Inactive</span>
                                    }
                                </div>
                            </div>
                            @if (!string.IsNullOrWhiteSpace(Model.ImagePath))
                            {
                                <div class="col-12">
                                    <label class="form-label text-muted small mb-1">Image Path</label>
                                    <div class="fw-semibold small text-break">@Model.ImagePath</div>
                                </div>
                            }
                        </div>

                        <hr class="my-4" />

                        <div class="d-flex gap-2 justify-content-end">
                            <a asp-area="Catalog" asp-controller="Products" asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary">Edit</a>
                            @if (Model.IsActive)
                            {
                                <form asp-area="Catalog" asp-controller="Products" asp-action="Deactivate" asp-route-id="@Model.Id" method="post">
                                    <button type="submit" class="btn btn-warning">Deactivate</button>
                                </form>
                            }
                            else
                            {
                                <form asp-area="Catalog" asp-controller="Products" asp-action="Activate" asp-route-id="@Model.Id" method="post">
                                    <button type="submit" class="btn btn-success">Activate</button>
                                </form>
                            }
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
</div>
