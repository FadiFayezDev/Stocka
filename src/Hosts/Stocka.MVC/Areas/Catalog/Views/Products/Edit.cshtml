@model Catalog.Application.UseCases.Products.UpdateProductCommand
@{
    ViewData["Title"] = "Edit Product";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="mb-4">
                <h2 class="mb-1">Edit Product</h2>
                <p class="text-muted mb-0">UseCase: UpdateProductCommand</p>
            </div>

            <div class="card border-0 shadow-sm">
                <div class="card-body p-4">
                    <form asp-area="Catalog" asp-controller="Products" asp-action="Edit" method="post">
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

                        <input type="hidden" asp-for="ProductId" />

                        <div class="mb-3">
                            <label class="form-label text-muted small">Product ID</label>
                            <div class="font-monospace small text-muted">@Model.ProductId</div>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Name" class="form-label">Product Name</label>
                            <input asp-for="Name" class="form-control" placeholder="Leave empty to keep current" />
                            <span asp-validation-for="Name" class="text-danger small"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="CategoryId" class="form-label">Category</label>
                            <select asp-for="CategoryId" class="form-select" asp-items="ViewBag.Categories">
                                <option value="">-- Keep current / Select category --</option>
                            </select>
                            <span asp-validation-for="CategoryId" class="text-danger small"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="SellingPrice" class="form-label">Selling Price</label>
                            <div class="input-group">
                                <input asp-for="SellingPrice" type="number" step="0.01" min="0" class="form-control" placeholder="Leave empty to keep current" />
                                <span class="input-group-text">$</span>
                            </div>
                            <span asp-validation-for="SellingPrice" class="text-danger small"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Barcode" class="form-label">Barcode</label>
                            <input asp-for="Barcode" class="form-control" placeholder="Leave empty to keep current" />
                            <span asp-validation-for="Barcode" class="text-danger small"></span>
                        </div>

                        <div class="mb-4">
                            <label asp-for="ImagePath" class="form-label">Image Path</label>
                            <input asp-for="ImagePath" class="form-control" placeholder="e.g. /images/products/xyz.jpg — leave empty to keep current, empty string to clear" />
                            <span asp-validation-for="ImagePath" class="text-danger small"></span>
                        </div>

                        <div class="d-flex justify-content-end gap-2">
                            <a asp-area="Catalog" asp-controller="Products" asp-action="Index" class="btn btn-light">Cancel</a>
                            <a asp-area="Catalog" asp-controller="Products" asp-action="Details" asp-route-id="@Model.ProductId" class="btn btn-outline-secondary">Details</a>
                            <button type="submit" class="btn btn-primary px-4">Save Changes</button>
                        </div>
                    </form>

                    <div class="alert alert-info mt-4 mb-0 small">
                        At least one field must be provided. Empty fields will keep their previous values. For Barcode/ImagePath, submitting an empty string will explicitly clear the value (depending on domain logic).
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
