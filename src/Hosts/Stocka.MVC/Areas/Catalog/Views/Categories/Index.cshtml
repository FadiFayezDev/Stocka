@model IEnumerable<Catalog.Application.DTOs.Category.CategoryDto>
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = ViewBag.Title ?? "Categories";
}

<div class="container-fluid py-4">

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="mb-1">Categories</h2>
            <p class="text-muted mb-0">Manage your categories — ListCategoriesCommand</p>
        </div>
        <div class="d-flex gap-2">
            <a class="btn btn-outline-secondary" asp-area="Catalog" asp-controller="Categories" asp-action="SearchByName">Search by Name</a>
            <a class="btn btn-primary" asp-area="Catalog" asp-controller="Categories" asp-action="Create">
                <i class="bi bi-plus-lg me-1"></i> Add Category
            </a>
        </div>
    </div>

    <!-- Categories Table -->
    <div class="card border-0 shadow-sm">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table-hover mb-0 table align-middle">
                    <thead class="table-light">
                        <tr>
                            <th class="ps-4">Name</th>
                            <th>Status</th>
                            <th>Brand</th>
                            <th class="pe-4 text-end">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model != null && Model.Any())
                        {
                            @foreach (var category in Model)
                            {
                                <tr>
                                    <td class="ps-4">
                                        <div class="fw-semibold">@category.Name</div>
                                        <small class="text-muted">@category.Id</small>
                                    </td>
                                    <td>
                                        @if (category.IsActive)
                                        {
                                            <span class="badge text-bg-success">Active</span>
                                        }
                                        else
                                        {
                                            <span class="badge text-bg-secondary">Inactive</span>
                                        }
                                    </td>
                                    <td>
                                        <small class="text-muted">@category.BrandId</small>
                                    </td>
                                    <td class="pe-4 text-end">
                                        <div class="btn-group" role="group">
                                            <a class="btn btn-sm btn-outline-primary"
                                               asp-area="Catalog" asp-controller="Categories" asp-action="Details" asp-route-id="@category.Id">Details</a>
                                            <a class="btn btn-sm btn-outline-secondary"
                                               asp-area="Catalog" asp-controller="Categories" asp-action="Edit" asp-route-id="@category.Id">Edit</a>

                                            @if (category.IsActive)
                                            {
                                                <form asp-area="Catalog" asp-controller="Categories" asp-action="Deactivate" asp-route-id="@category.Id" method="post" class="d-inline">
                                                    <button type="submit" class="btn btn-sm btn-outline-warning">Deactivate</button>
                                                </form>
                                            }
                                            else
                                            {
                                                <form asp-area="Catalog" asp-controller="Categories" asp-action="Activate" asp-route-id="@category.Id" method="post" class="d-inline">
                                                    <button type="submit" class="btn btn-sm btn-outline-success">Activate</button>
                                                </form>
                                            }
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="4" class="py-5 text-center">
                                    <div class="text-muted">
                                        <div class="fs-4 mb-2">No categories found</div>
                                        <small>There are no categories to display. Try creating one.</small>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
