@model Catalog.Application.DTOs.Category.CategoryDto
@{
    ViewData["Title"] = "Search Category";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="mb-4">
                <h2 class="mb-1">Search Category by Name</h2>
                <p class="text-muted mb-0">UseCase: RetrieveCategoryByNameCommand</p>
            </div>

            <div class="card border-0 shadow-sm mb-4">
                <div class="card-body p-4">
                    <form asp-area="Catalog" asp-controller="Categories" asp-action="SearchByName" method="get" class="row g-3">
                        <div class="col-md-9">
                            <label class="form-label">Category Name</label>
                            <input name="name" value="@Context.Request.Query["name"]" class="form-control" placeholder="Enter category name to search" />
                        </div>
                        <div class="col-md-3 d-flex align-items-end">
                            <button type="submit" class="btn btn-primary w-100">Search</button>
                        </div>
                    </form>
                    @if (ViewBag.NotFound != null)
                    {
                        <div class="alert alert-warning mt-3 mb-0">@ViewBag.NotFound</div>
                    }
                    @if (ViewBag.Error != null)
                    {
                        <div class="alert alert-danger mt-3 mb-0">@ViewBag.Error</div>
                    }
                </div>
            </div>

            @if (Model != null)
            {
                <div class="card border-0 shadow-sm">
                    <div class="card-body p-4">
                        <h5 class="card-title">Result</h5>
                        <div class="row g-3">
                            <div class="col-md-6">
                                <label class="form-label text-muted small mb-1">ID</label>
                                <div class="fw-semibold font-monospace small">@Model.Id</div>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label text-muted small mb-1">Brand ID</label>
                                <div class="fw-semibold font-monospace small">@Model.BrandId</div>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label text-muted small mb-1">Name</label>
                                <div class="fw-semibold">@Model.Name</div>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label text-muted small mb-1">Status</label>
                                <div>
                                    @if (Model.IsActive)
                                    {
                                        <span class="badge text-bg-success">Active</span>
                                    }
                                    else
                                    {
                                        <span class="badge text-bg-secondary">Inactive</span>
                                    }
                                </div>
                            </div>
                        </div>
                        <div class="mt-4 d-flex gap-2">
                            <a asp-area="Catalog" asp-controller="Categories" asp-action="Details" asp-route-id="@Model.Id" class="btn btn-primary btn-sm">View Details</a>
                            <a asp-area="Catalog" asp-controller="Categories" asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-outline-secondary btn-sm">Edit</a>
                        </div>
                    </div>
                </div>
            }
            else if (!string.IsNullOrWhiteSpace(Context.Request.Query["name"]) && ViewBag.NotFound == null)
            {
                <div class="text-center text-muted py-4">
                    <p>No category found. Try another name.</p>
                </div>
            }

            <div class="mt-3">
                <a asp-area="Catalog" asp-controller="Categories" asp-action="Index" class="btn btn-light">Back to List</a>
            </div>
        </div>
    </div>
</div>
