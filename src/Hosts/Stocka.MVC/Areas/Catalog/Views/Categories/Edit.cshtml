@model Catalog.Application.UseCases.Categories.UpdateCategoryCommand
@{
    ViewData["Title"] = "Edit Category";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-lg-6">
            <div class="mb-4">
                <h2 class="mb-1">Edit Category</h2>
                <p class="text-muted mb-0">UseCase: UpdateCategoryCommand</p>
            </div>

            <div class="card border-0 shadow-sm">
                <div class="card-body p-4">
                    <form asp-area="Catalog" asp-controller="Categories" asp-action="Edit" method="post">
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

                        <input type="hidden" asp-for="CategoryId" />

                        <div class="mb-3">
                            <label class="form-label text-muted small">Category ID</label>
                            <div class="font-monospace small text-muted">@Model.CategoryId</div>
                        </div>

                        <div class="mb-4">
                            <label asp-for="Name" class="form-label">Category Name</label>
                            <input asp-for="Name" class="form-control" placeholder="Enter new category name" />
                            <span asp-validation-for="Name" class="text-danger small"></span>
                        </div>

                        <div class="d-flex justify-content-end gap-2">
                            <a asp-area="Catalog" asp-controller="Categories" asp-action="Index" class="btn btn-light">Cancel</a>
                            <a asp-area="Catalog" asp-controller="Categories" asp-action="Details" asp-route-id="@Model.CategoryId" class="btn btn-outline-secondary">Details</a>
                            <button type="submit" class="btn btn-primary px-4">Save Changes</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
