@using System.Globalization
@using Microsoft.AspNetCore.Http
@using Stocka.MVC.Infrastructure
@{
    /* ---- Culture & direction (single source for the whole shell) ---- */
    var isRtl = CultureInfo.CurrentUICulture.TextInfo.IsRightToLeft;
    var htmlLang = CultureInfo.CurrentUICulture.TwoLetterISOLanguageName;

    // return URL for the language switch, stripped of any culture parameters
    var langQuery = Context.Request.Query
        .Where(kv => kv.Key != "culture" && kv.Key != "ui-culture" && kv.Value.Count > 0)
        .Select(kv => new KeyValuePair<string, string?>(kv.Key, kv.Value.ToString()))
        .ToList();
    var langQs = QueryString.Create(langQuery);
    var returnUrl = Context.Request.Path + (langQs.HasValue ? langQs.ToUriComponent() : "");

    var other = isRtl ? "en" : "ar";                 // culture we switch to
    var otherLabel = isRtl ? "EN" : "عربي";          // label of the target language

    // Shell copy intentionally lives with the shell until resource files are introduced.
    var Loc = new Dictionary<string, string>
    {
        ["Val_Required"] = isRtl ? "هذا الحقل مطلوب." : "This field is required.", ["Val_Email"] = isRtl ? "أدخل بريداً إلكترونياً صحيحاً." : "Enter a valid email address.", ["Val_Url"] = isRtl ? "أدخل رابطاً صحيحاً." : "Enter a valid URL.", ["Val_Pattern"] = isRtl ? "القيمة غير صالحة." : "The value is invalid.", ["Val_MinLength"] = isRtl ? "القيمة أقصر من المطلوب." : "The value is too short.", ["Val_MaxLength"] = isRtl ? "القيمة أطول من المسموح." : "The value is too long.", ["Val_Min"] = isRtl ? "القيمة أقل من الحد الأدنى." : "The value is below the minimum.", ["Val_Max"] = isRtl ? "القيمة أكبر من الحد الأقصى." : "The value exceeds the maximum.", ["Val_Step"] = isRtl ? "أدخل قيمة صحيحة." : "Enter a valid step value.", ["Val_Number"] = isRtl ? "أدخل رقماً صحيحاً." : "Enter a valid number.", ["Val_OneIssue"] = isRtl ? "يرجى تصحيح الخطأ التالي:" : "Please fix the following issue:", ["Val_ManyIssues"] = isRtl ? "يرجى تصحيح الأخطاء التالية:" : "Please fix the following issues:",
        ["SkipToContent"] = isRtl ? "انتقل إلى المحتوى" : "Skip to content", ["Nav_Main"] = isRtl ? "التنقل الرئيسي" : "Main navigation", ["App_Subtitle"] = isRtl ? "إدارة المخزون" : "Inventory control", ["Nav_Home"] = isRtl ? "الرئيسية" : "Home", ["Group_Catalog"] = isRtl ? "الكتالوج" : "Catalog", ["Nav_Products"] = isRtl ? "المنتجات" : "Products", ["Nav_Categories"] = isRtl ? "الفئات" : "Categories", ["Group_Inventory"] = isRtl ? "المخزون" : "Inventory", ["Nav_Warehouses"] = isRtl ? "المستودعات" : "Warehouses", ["Nav_Batches"] = isRtl ? "الدفعات" : "Batches", ["Nav_Movements"] = isRtl ? "الحركات" : "Movements", ["Nav_Reports"] = isRtl ? "التقارير" : "Reports", ["Nav_ReportsOverview"] = isRtl ? "نظرة عامة" : "Overview", ["Nav_Balance"] = isRtl ? "الرصيد" : "Balance", ["Nav_MovementReports"] = isRtl ? "تقرير الحركات" : "Movement report", ["Nav_ZeroStock"] = isRtl ? "نفاد المخزون" : "Zero stock", ["Nav_WarehouseReports"] = isRtl ? "تقارير المستودعات" : "Warehouse reports", ["Nav_Collapse"] = isRtl ? "طي القائمة" : "Collapse navigation", ["Nav_Open"] = isRtl ? "فتح القائمة" : "Open navigation", ["Search_Placeholder"] = isRtl ? "ابحث عن منتج" : "Search products", ["Lang_ChangeTo"] = isRtl ? "التبديل إلى الإنجليزية" : "Switch to Arabic", ["Theme_Light"] = isRtl ? "الوضع الفاتح" : "Light theme", ["Theme_Dark"] = isRtl ? "الوضع الداكن" : "Dark theme", ["Footer_Copy"] = "© Stocka", ["Footer_Note"] = isRtl ? "نظام إدارة الأعمال" : "Business operations system"
    };

    string? title = ViewData["Title"] as string;

    // validator + JS strings, serialized once, consumed by app.js
    var i18n = new
    {
        required = (string)Loc["Val_Required"],
        email    = (string)Loc["Val_Email"],
        url      = (string)Loc["Val_Url"],
        pattern  = (string)Loc["Val_Pattern"],
        minlength = (string)Loc["Val_MinLength"],
        maxlength = (string)Loc["Val_MaxLength"],
        min      = (string)Loc["Val_Min"],
        max      = (string)Loc["Val_Max"],
        step     = (string)Loc["Val_Step"],
        number   = (string)Loc["Val_Number"],
        oneIssue = (string)Loc["Val_OneIssue"],
        manyIssues = (string)Loc["Val_ManyIssues"]
    };
}
@functions {
    /* nav helpers — used only by this layout */
    string NavActive(string area, string controller, string? action = null)
    {
        var r = ViewContext.RouteData;
        var curArea = r.Values["area"]?.ToString() ?? "";
        var curCtrl = r.Values["controller"]?.ToString() ?? "";
        if (string.Equals(curArea, area, StringComparison.OrdinalIgnoreCase) &&
            string.Equals(curCtrl, controller, StringComparison.OrdinalIgnoreCase) &&
            (action is null || string.Equals(r.Values["action"]?.ToString(), action, StringComparison.OrdinalIgnoreCase)))
            return "is-active";
        return "";
    }

    bool NavGroupActive(string area, string? controller = null)
    {
        var r = ViewContext.RouteData;
        var curArea = r.Values["area"]?.ToString() ?? "";
        if (!string.Equals(curArea, area, StringComparison.OrdinalIgnoreCase)) return false;
        if (controller is null) return true;
        return string.Equals(r.Values["controller"]?.ToString(), controller, StringComparison.OrdinalIgnoreCase);
    }
}
<!DOCTYPE html>
<html lang="@htmlLang" dir="@(isRtl ? "rtl" : "ltr")" data-theme="light">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="color-scheme" content="light dark" />
    <title>@(string.IsNullOrWhiteSpace(title) ? "Stocka" : title + " · Stocka")</title>

    @* theme boot — runs before CSS paint, no light/dark flash *@
    <script>
        (function () {
            var t = null;
            try { t = localStorage.getItem("stocka-theme"); } catch (e) { }
            if (t !== "light" && t !== "dark") {
                t = (window.matchMedia && window.matchMedia("(prefers-color-scheme: dark)").matches) ? "dark" : "light";
            }
            var d = document.documentElement;
            d.setAttribute("data-theme", t);
            d.style.colorScheme = t;
        })();
    </script>

    <link rel="stylesheet" href="~/css/tokens.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/base.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/shell.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/components.css" asp-append-version="true" />
</head>
<body>

    @* ============ icon sprite (hand-drawn, 24×24, stroke) ============ *@
    <svg xmlns="http://www.w3.org/2000/svg" style="display:none" aria-hidden="true">
        <symbol id="i-home" viewBox="0 0 24 24">
            <path d="M4 11.2 12 4.4l8 6.8" /><path d="M6.3 9.7V20h11.4V9.7" /><path d="M10 20v-5.4h4V20" />
        </symbol>
        <symbol id="i-box" viewBox="0 0 24 24">
            <path d="M12 3 3.5 7.7v8.6L12 21l8.5-4.7V7.7L12 3z" /><path d="M3.8 8 12 12.5l8.2-4.5" /><path d="M12 12.5V21" />
        </symbol>
        <symbol id="i-tag" viewBox="0 0 24 24">
            <path d="M4 4.7h6.9l9.2 9.2a2 2 0 0 1 0 2.8l-3.4 3.4a2 2 0 0 1-2.8 0L4 11.6V4.7z" />
            <circle cx="7.7" cy="8.4" r="1.2" />
        </symbol>
        <symbol id="i-store" viewBox="0 0 24 24">
            <path d="M4 21V9.3l8-5.7 8 5.7V21" /><path d="M2.8 9.6 12 3.6l9.2 6" /><path d="M9.3 21v-6.4h5.4V21" /><path d="M4 21h16" />
        </symbol>
        <symbol id="i-layers" viewBox="0 0 24 24">
            <path d="M12 3 3.3 7.7 12 12.4l8.7-4.7L12 3z" /><path d="M3.3 12.2 12 17l8.7-4.8" /><path d="M3.3 16.6 12 21.4l8.7-4.8" />
        </symbol>
        <symbol id="i-swap" viewBox="0 0 24 24">
            <path d="M4 7.3h16.6" /><path d="M17.3 4.2l3.2 3.1-3.2 3.1" />
            <path d="M20 16.7H3.4" /><path d="M6.7 13.6 3.4 16.7l3.3 3.1" />
        </symbol>
        <symbol id="i-chart" viewBox="0 0 24 24">
            <path d="M3.8 20h16.4" /><path d="M6.5 20v-6.2" /><path d="M12 20V6.4" /><path d="M17.5 20V10.8" />
        </symbol>
        <symbol id="i-menu" viewBox="0 0 24 24"><path d="M4 7h16" /><path d="M4 12h16" /><path d="M4 17h16" /></symbol>
        <symbol id="i-chevrons" viewBox="0 0 24 24"><path d="M4.5 5.5 11 12l-6.5 6.5" /><path d="M11.5 5.5 18 12l-6.5 6.5" /></symbol>
        <symbol id="i-search" viewBox="0 0 24 24"><circle cx="11" cy="11" r="6.6" /><path d="M20 20l-4.1-4.1" /></symbol>
        <symbol id="i-globe" viewBox="0 0 24 24">
            <circle cx="12" cy="12" r="8.6" /><path d="M3.4 12h17.2" />
            <path d="M12 3.4c2.5 2.3 4 5.3 4 8.6s-1.5 6.3-4 8.6c-2.5-2.3-4-5.3-4-8.6s1.5-6.3 4-8.6z" />
        </symbol>
        <symbol id="i-sun" viewBox="0 0 24 24">
            <circle cx="12" cy="12" r="4.2" />
            <path d="M12 2.6v2.4M12 19v2.4M2.6 12h2.4M19 12h2.4M5 5l1.7 1.7M17.3 17.3 19 19M19 5l-1.7 1.7M6.7 17.3 5 19" />
        </symbol>
        <symbol id="i-moon" viewBox="0 0 24 24"><path d="M20.6 13.2A8.6 8.6 0 1 1 10.8 3.4a7 7 0 0 0 9.8 9.8z" /></symbol>
        <symbol id="i-plus" viewBox="0 0 24 24"><path d="M12 5.4v13.2" /><path d="M5.4 12h13.2" /></symbol>
        <symbol id="i-pencil" viewBox="0 0 24 24">
            <path d="M16.2 4.2a1.9 1.9 0 0 1 2.7 2.7L7.6 18.2 4 19l.8-3.6 11.4-11.2z" /><path d="M14.8 5.6l2.7 2.7" />
        </symbol>
        <symbol id="i-eye" viewBox="0 0 24 24">
            <path d="M2.8 12S6 5.9 12 5.9 21.2 12 21.2 12 18 18.1 12 18.1 2.8 12 2.8 12z" /><circle cx="12" cy="12" r="2.7" />
        </symbol>
        <symbol id="i-archive" viewBox="0 0 24 24">
            <path d="M4 5h16v3.4H4z" /><path d="M5.6 8.4V19a1 1 0 0 0 1 1h10.8a1 1 0 0 0 1-1V8.4" /><path d="M9.7 12.3h4.6" />
        </symbol>
        <symbol id="i-check-circle" viewBox="0 0 24 24">
            <circle cx="12" cy="12" r="8.6" /><path d="M8.2 12.3l2.6 2.6 5-5.4" />
        </symbol>
        <symbol id="i-check" viewBox="0 0 24 24"><path d="M5.5 12.6l4.2 4.2 8.8-9.6" /></symbol>
        <symbol id="i-x" viewBox="0 0 24 24"><path d="M6.4 6.4l11.2 11.2" /><path d="M17.6 6.4 6.4 17.6" /></symbol>
        <symbol id="i-chevron-down" viewBox="0 0 24 24"><path d="M6.5 9.5 12 15l5.5-5.5" /></symbol>
        <symbol id="i-chevron-start" viewBox="0 0 24 24"><path d="M14.5 5.5 8 12l6.5 6.5" /></symbol>
        <symbol id="i-chevron-end" viewBox="0 0 24 24"><path d="M9.5 5.5 16 12l-6.5 6.5" /></symbol>
        <symbol id="i-arrow-up" viewBox="0 0 24 24"><path d="M12 19V5" /><path d="M5.8 11.2 12 5l6.2 6.2" /></symbol>
        <symbol id="i-arrow-down" viewBox="0 0 24 24"><path d="M12 5v14" /><path d="M5.8 12.8 12 19l6.2-6.2" /></symbol>
        <symbol id="i-trash" viewBox="0 0 24 24">
            <path d="M4.5 7h15" /><path d="M9.5 7V4.8h5V7" />
            <path d="M6.6 7l.9 13h9l.9-13" /><path d="M10 11v5.4" /><path d="M14 11v5.4" />
        </symbol>
        <symbol id="i-alert" viewBox="0 0 24 24">
            <path d="M12 3.6 22 20.4H2L12 3.6z" /><path d="M12 10v4.6" /><path d="M12 17.7h.01" />
        </symbol>
        <symbol id="i-info" viewBox="0 0 24 24"><circle cx="12" cy="12" r="8.6" /><path d="M12 11.2v5" /><path d="M12 8.1h.01" /></symbol>
        <symbol id="i-image" viewBox="0 0 24 24">
            <rect x="4" y="5" width="16" height="14" rx="2" /><circle cx="8.6" cy="9.4" r="1.5" />
            <path d="M5.5 17.5l4.3-4.3 2.7 2.7 3.2-3.2 3.3 3.3" />
        </symbol>
        <symbol id="i-upload" viewBox="0 0 24 24">
            <path d="M12 15.6V4.4" /><path d="M7.6 8.8 12 4.4l4.4 4.4" />
            <path d="M4.4 15.6v3.2a1 1 0 0 0 1 1h13.2a1 1 0 0 0 1-1v-3.2" />
        </symbol>
        <symbol id="i-calendar" viewBox="0 0 24 24">
            <rect x="4.4" y="5.6" width="15.2" height="13.6" rx="2" /><path d="M4.4 9.8h15.2" />
            <path d="M8.5 3.6v3.4" /><path d="M15.5 3.6v3.4" />
        </symbol>
        <symbol id="i-filter" viewBox="0 0 24 24"><path d="M4 5h16l-6.2 7.2v5.6l-3.6 2V12.2L4 5z" /></symbol>
        <symbol id="i-undo" viewBox="0 0 24 24">
            <path d="M4.4 9.2h10.8a4.6 4.6 0 1 1 0 9.2H9.4" /><path d="M8.4 5 4.4 9.2l4 4.2" />
        </symbol>
        <symbol id="i-external" viewBox="0 0 24 24">
            <path d="M18.6 13.2v5.2a1.4 1.4 0 0 1-1.4 1.4H5.2a1.4 1.4 0 0 1-1.4-1.4V6.8a1.4 1.4 0 0 1 1.4-1.4h5.2" />
            <path d="M14.6 4h5.4v5.4" /><path d="M20 4l-8.4 8.4" />
        </symbol>
    </svg>

    <a class="skip-link" href="#content">@Loc["SkipToContent"]</a>

    <div class="shell" id="shell" data-nav-open="false">

        @* ============ Sidebar ============ *@
        <aside class="sidebar" id="sidebar" aria-label="@Loc["Nav_Main"]">
            <a class="brand" asp-area="" asp-controller="Home" asp-action="Index">
                <span class="brand-mark"><svg class="icon"><use href="#i-box" /></svg></span>
                <span class="brand-name">
                    <b>Stocka</b>
                    <span>@Loc["App_Subtitle"]</span>
                </span>
            </a>

            <nav class="nav">
                <a class="nav-link @NavActive("", "Home")" asp-area="" asp-controller="Home" asp-action="Index">
                    <svg class="icon"><use href="#i-home" /></svg><span class="nav-text">@Loc["Nav_Home"]</span>
                </a>

                <span class="group-label" aria-hidden="true">@Loc["Group_Catalog"]</span>
                <a class="nav-link @NavActive("Catalog", "Products")" asp-area="Catalog" asp-controller="Products" asp-action="Index">
                    <svg class="icon"><use href="#i-box" /></svg><span class="nav-text">@Loc["Nav_Products"]</span>
                </a>
                <a class="nav-link @NavActive("Catalog", "Categories")" asp-area="Catalog" asp-controller="Categories" asp-action="Index">
                    <svg class="icon"><use href="#i-tag" /></svg><span class="nav-text">@Loc["Nav_Categories"]</span>
                </a>

                <span class="group-label" aria-hidden="true">@Loc["Group_Inventory"]</span>
                <a class="nav-link @NavActive("Inventory", "Warehouses")" asp-area="Inventory" asp-controller="Warehouses" asp-action="Index">
                    <svg class="icon"><use href="#i-store" /></svg><span class="nav-text">@Loc["Nav_Warehouses"]</span>
                </a>
                <a class="nav-link @NavActive("Inventory", "Batches")" asp-area="Inventory" asp-controller="Batches" asp-action="Index">
                    <svg class="icon"><use href="#i-layers" /></svg><span class="nav-text">@Loc["Nav_Batches"]</span>
                </a>
                <a class="nav-link @NavActive("Inventory", "Stock", "Movements")" asp-area="Inventory" asp-controller="Stock" asp-action="Movements">
                    <svg class="icon"><use href="#i-swap" /></svg><span class="nav-text">@Loc["Nav_Movements"]</span>
                </a>

                <details class="nav-group@(NavGroupActive("Inventory", "Reports") ? " is-open" : "")">
                    <summary title="@Loc["Nav_Reports"]" aria-label="@Loc["Nav_Reports"]">
                        @Loc["Nav_Reports"]
                        <svg class="icon chev"><use href="#i-chevron-down" /></svg>
                    </summary>
                    <div class="nav">
                        <a class="nav-link @NavActive("Inventory", "Reports", "Index")" asp-area="Inventory" asp-controller="Reports" asp-action="Index">
                            <span class="nav-text">@Loc["Nav_ReportsOverview"]</span>
                        </a>
                        <a class="nav-link @NavActive("Inventory", "Reports", "Balance")" asp-area="Inventory" asp-controller="Reports" asp-action="Balance">
                            <span class="nav-text">@Loc["Nav_Balance"]</span>
                        </a>
                        <a class="nav-link @NavActive("Inventory", "Reports", "Movements")" asp-area="Inventory" asp-controller="Reports" asp-action="Movements">
                            <span class="nav-text">@Loc["Nav_MovementReports"]</span>
                        </a>
                        <a class="nav-link @NavActive("Inventory", "Reports", "Products")" asp-area="Inventory" asp-controller="Reports" asp-action="Products">
                            <span class="nav-text">@Loc["Nav_ZeroStock"]</span>
                        </a>
                        <a class="nav-link @NavActive("Inventory", "Reports", "Warehouses")" asp-area="Inventory" asp-controller="Reports" asp-action="Warehouses">
                            <span class="nav-text">@Loc["Nav_WarehouseReports"]</span>
                        </a>
                    </div>
                </details>
            </nav>

            <div class="aside-foot">
                <button type="button" class="collapse-btn" data-rail-toggle
                        aria-label="@Loc["Nav_Collapse"]" title="@Loc["Nav_Collapse"]">
                    <svg class="icon icon-collapse"><use href="#i-chevrons" /></svg>
                </button>
            </div>
        </aside>

        <div class="scrim" data-nav-close></div>

        @* ============ Frame ============ *@
        <div class="frame">
            <header class="topbar">
                <button type="button" class="tool-btn menu-btn" data-nav-toggle aria-label="@Loc["Nav_Open"]">
                    <svg class="icon"><use href="#i-menu" /></svg>
                </button>

                <a class="topbar-brand" asp-area="" asp-controller="Home" asp-action="Index">
                    <span class="brand-mark" style="width:26px;height:26px;border-radius:7px;"><svg class="icon" style="width:15px;height:15px;"><use href="#i-box" /></svg></span>
                    Stocka
                </a>

                <form class="searchbar" role="search" method="get"
                      asp-area="Catalog" asp-controller="Products" asp-action="SearchByName">
                    <svg class="icon"><use href="#i-search" /></svg>
                    <input type="search" name="name" autocomplete="off" placeholder="@Loc["Search_Placeholder"]" aria-label="@Loc["Search_Placeholder"]" />
                </form>

                <div class="topbar-side">
                    <a class="lang-chip" asp-controller="Localization" asp-action="SetLanguage"
                       asp-route-culture="@other" asp-route-returnUrl="@returnUrl"
                       title="@Loc["Lang_ChangeTo"]">
                        <svg class="icon"><use href="#i-globe" /></svg>
                        <span>@otherLabel</span>
                    </a>
                    <button type="button" class="tool-btn" data-theme-toggle
                            data-aria-label-light="@Loc["Theme_Light"]" data-aria-label-dark="@Loc["Theme_Dark"]"
                            aria-label="@Loc["Theme_Dark"]">
                        <svg class="icon theme-ic theme-ic-sun"><use href="#i-sun" /></svg>
                        <svg class="icon theme-ic theme-ic-moon"><use href="#i-moon" /></svg>
                    </button>
                </div>
            </header>

            <main class="content" id="content">
                <partial name="_Flash" />
                @RenderBody()
            </main>

            <footer class="footer">
                <span>@Loc["Footer_Copy"]</span>
                <span class="spacer"></span>
                <span>@Loc["Footer_Note"]</span>
            </footer>
        </div>
    </div>

    <script type="application/json" id="stocka-i18n">@Json.Serialize(i18n)</script>
    <script src="~/js/app.js" asp-append-version="true" defer></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
